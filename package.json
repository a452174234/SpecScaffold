{
  "name": "spec-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Harness Engineering 的 Web 端图形化脚手架平台",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/main.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "db:init": "tsx backend/src/db/init.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "uuid": "^14.0.0",
    "vitest": "^3.0.0"
  }
}
